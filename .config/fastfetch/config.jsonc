{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

"logo": {
    "type": "small",        // Logo type: auto, builtin, small, file, etc.
    // "source": "~/Downloads/madvillainy.jpg",
    // "height": 16,
    "padding": {
        "right":8,
        "left":2,
        "top":3,
        "bottom":0
    }

},
  "display": {
    "separator": ": ",
    "color": {
        "keys": "blue",    // Key color
        "title": "red"     // Title color
    },
    "key": {
        "width": 10,       // Aligns keys to this width
        "type": "string"   // string, icon, both, or none
    },
    "bar": {
        "width": 10,       // Width of percentage bars
        "char": {
            "elapsed": "■", // Character for elapsed portion
            "total": "-",    // Character for total portion
        }
    },
    "percent": {
        "type": 2,         // 1=number, 2=bar, 3=both, 9=colored number
        "color": {
            "green": "green",
            "yellow": "light_yellow",
            "red": "light_red"
        }
    }
  },

  "modules": [
    "title",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    "break",
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    "break",
    {
      "type": "disk",
      "key": "Root",
      "folders": ["/"]
    },
    {
      "type": "disk",
      "key": "Home",
      "folders": ["/home"]
    }
  ]
}
